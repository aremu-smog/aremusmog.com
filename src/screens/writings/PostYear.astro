---
import YearGroup from "../../components/YearGroup.astro"
import { formatDate, type Post } from "./writings"

interface Props {
	year: number
	posts: Post[]
	/** Whether the year starts expanded */
	open?: boolean
}

const { year, posts, open = false } = Astro.props
---

<YearGroup year={year} open={open}>
	<ul class="post-list">
		{
			posts.map((post) => (
				<li class="post">
					<a class="post__link" href={post.url} target="_blank" rel="noopener">
						<p class="post__meta">
							<time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
							<span aria-hidden="true">·</span>
							{post.readingTime} min read
						</p>
						<p class="post__title">{post.title}</p>
						<p class="post__excerpt">{post.excerpt}</p>
					</a>
				</li>
			))
		}
	</ul>
</YearGroup>
