---
import { getImage } from "astro:assets"
import DotIcon from "./DotIcon.astro"
import type { MotionPiece } from "./motion"

interface Props {
	piece: MotionPiece
}

const { piece } = Astro.props
const { title, kind, width, height, sound, video } = piece
const poster = await getImage({ src: piece.poster, format: "webp", quality: 70 })
// Wide pieces take the full row; square ones sit two to a row
const wide = width > height
---

<li class:list={["motion-piece", { "motion-piece--wide": wide }]}>
	{/* player.ts drives this; state lives in data-state and data-muted */}
	<div class="player" data-player data-state="paused">
		{/* Nothing loads until play is pressed, so the page only fetches posters */}
		<video
			src={video}
			poster={poster.src}
			width={width}
			height={height}
			preload="none"
			playsinline
			muted={!sound}
			class="player__video"
		/>
		<button type="button" class="player__big" data-toggle aria-label={`Play ${title}`}>
			<DotIcon name="play" class="player__icon player__icon--play" />
		</button>
		<div class="player__bar">
			<button type="button" class="player__button" data-toggle aria-label="Play">
				<DotIcon name="play" class="player__icon player__icon--play" />
				<DotIcon name="pause" class="player__icon player__icon--pause" />
			</button>
			<div class="player__progress">
				<span class="player__fill" />
				<input
					type="range"
					class="player__seek"
					min="0"
					max="1000"
					value="0"
					step="1"
					aria-label={`Seek ${title}`}
					data-seek
				/>
			</div>
			<span class="player__time" data-time>0:00</span>
			{
				sound && (
					<button type="button" class="player__button" data-mute aria-label="Mute">
						<DotIcon name="sound" class="player__icon player__icon--sound" />
						<DotIcon name="muted" class="player__icon player__icon--muted" />
					</button>
				)
			}
			<button type="button" class="player__button" data-fullscreen aria-label="Full screen">
				<DotIcon name="fullscreen" class="player__icon" />
			</button>
		</div>
	</div>
	<p class="motion-piece__caption">
		<span class="motion-piece__title">{title}</span>
		<span class="motion-piece__kind">{kind}</span>
	</p>
</li>

<script>
	import { setUpPlayers } from "./player"
	setUpPlayers()
</script>
