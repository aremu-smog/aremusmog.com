---
interface Props {
	image: string
	imageAlt: string
	title: string
	/** Adds `header--sticky` (used on the books page) */
	sticky?: boolean
}

const { image, imageAlt, title, sticky = false } = Astro.props
---

<header class:list={["header", { "header--sticky": sticky }]}>
	<img
		src={image}
		alt={imageAlt}
		width="160"
		height="160"
		class="header__image"
	/>
	<h1 class="header__title"><a href="/">{title}</a></h1>
	<p class="header__subtitle"><slot name="subtitle" /></p>
	<slot />
</header>
