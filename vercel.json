{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/amgl",
      "destination": "https://amgl.aremusmog.com/amgl"
    },
    {
      "source": "/amgl/:path*",
      "destination": "https://amgl.aremusmog.com/amgl/:path*"
    },
    {
      "source": "/donda",
      "destination": "https://donda.aremusmog.com/"
    },
    {
      "source": "/donda/:path*",
      "destination": "https://donda.aremusmog.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(font|image)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
